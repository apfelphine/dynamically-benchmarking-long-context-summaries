# --- LaTeX Integration ---
text.usetex: True
text.latex.preamble: \usepackage{amsmath} \usepackage{amssymb} \usepackage{bm} \usepackage[T1]{fontenc} \usepackage{icomma}

# --- Dimensions ---
figure.figsize: 6.2, 3.8
figure.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.1

# --- Font ---
font.size: 12
axes.labelsize: 12
axes.titlesize: 12
legend.fontsize: 14
xtick.labelsize: 12
ytick.labelsize: 12
pdf.fonttype: 42
ps.fonttype: 42
font.family: serif
font.serif: Computer Modern Roman

# --- Aesthetics ---
axes.linewidth: 0.6
grid.linewidth: 0.6
lines.linewidth: 1.5
lines.markersize: 4
axes.grid: True
axes.axisbelow: True
grid.alpha: 0.3
grid.linestyle: --